{
  "name": "${localWorkspaceFolderBasename} (@@TEMPLATE_NAME@@ Sandbox)",
  "build": {
    "dockerfile": "Dockerfile",
    "args": {
      "AGY_VERSION": "1.4.6"
    }
  },
  "remoteUser": "vscode",
  "workspaceFolder": "/workspaces/${localWorkspaceFolderBasename}",
  "workspaceMount": "source=${localWorkspaceFolder},target=/workspaces/${localWorkspaceFolderBasename},type=bind",
  "mounts": [
    "source=agy-shared-config,target=/home/vscode/.gemini-shared,type=volume",
    "source=agy-shared-cache,target=/home/vscode/.cache,type=volume",
    "source=agy-gemini-data-${localWorkspaceFolderBasename},target=/home/vscode/.gemini,type=volume",
    "source=${localWorkspaceFolder}/.devcontainer,target=${containerWorkspaceFolder}/.devcontainer,type=bind,readonly"
  ],
  "initializeCommand": "bash -c 'ready=\"/run/agy-sandbox/network.ready\"; if [ ! -s \"$ready\" ]; then echo \"[FAIL-CLOSED] Sandbox network isolation is NOT active! Run: sudo ./scripts/ensure-network.sh\" >&2; exit 1; fi; br=$(grep \"^ACTIVE_BRIDGE=\" \"$ready\" 2>/dev/null | cut -d= -f2); [ -z \"$br\" ] && br=\"agy0\"; if ! ip rule show 2>/dev/null | grep -q \"iif ${br}\"; then echo \"[FAIL-CLOSED] Sandbox network isolation is NOT active! Missing RPDB routing rules for ${br}. Run: sudo ./scripts/ensure-network.sh\" >&2; exit 1; fi'",
  "capDrop": [
    "NET_RAW"
  ],
  "runArgs": [
    "--network=agy_net",
    "--dns=9.9.9.9",
    "--dns=149.112.112.112",
    "--security-opt=no-new-privileges:true",
    "--cap-drop=NET_RAW",
    "--sysctl=net.ipv6.conf.all.disable_ipv6=1",
    "--sysctl=net.ipv6.conf.default.disable_ipv6=1",
    "--pids-limit=2048",
    "--memory=8g",
    "--cpus=4",
    "--tmpfs=/tmp:rw,nosuid,nodev,size=2g,mode=1777",
    "--init"
  ],
  "remoteEnv": {
    "AGY_VERSION": "1.4.6",
    "AGY_PATCH": "true",
    "UV_CACHE_DIR": "/home/vscode/.cache/uv",
    "AGY_CACHE_DIR": "/home/vscode/.cache/agy-downloads",
    "SSH_AUTH_SOCK": "",
    "VSCODE_GIT_IPC_HANDLE": "",
    "VSCODE_GIT_ASKPASS_NODE": "",
    "VSCODE_GIT_ASKPASS_MAIN": "",
    "GIT_ASKPASS": "/bin/false",
    "SSH_ASKPASS": "/bin/false"
  },
  "postCreateCommand": [
    "/usr/local/share/agy-sandbox/setup.sh",
    "${containerWorkspaceFolder}"
  ],
  "postStartCommand": "rm -f /tmp/vscode-git-*.sock /tmp/vscode-ssh-auth-*.sock /home/vscode/.gitconfig 2>/dev/null || true",
  "customizations": {
    "vscode": {
      "settings": {
        "terminal.integrated.defaultProfile.linux": "bash",
        "dev.containers.copyGitConfig": false,
        "dev.containers.dockerCredentialHelper": false,
        "git.terminalAuthentication": false,
        "github.gitAuthentication": false,
        "git.autofetch": false
      },
      "extensions": []
    }
  }
}
